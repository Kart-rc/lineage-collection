{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage.local/contracts/consolidated-edge/1.0.0",
  "title": "ConsolidatedEdge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "edgeKey",
    "from",
    "to",
    "edgeType",
    "band",
    "corroboration",
    "status",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "edgeKey": {"type": "string", "minLength": 1},
    "from": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "to": {"type": "string", "minLength": 1},
    "edgeType": {"enum": ["DERIVES", "READS", "WRITES", "SAME_AS"]},
    "band": {"enum": ["LOWEST", "SINGLE", "MEDIUM", "HIGH", "HIGHEST"]},
    "corroboration": {"enum": ["NONE", "DATASET", "ELEMENT"]},
    "status": {"enum": ["PROPOSED", "PUBLISHED", "STALE", "TOMBSTONED", "CONFLICTING"]},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "transform": {"type": "string"},
    "autoPublishable": {"type": "boolean"}
  }
}
