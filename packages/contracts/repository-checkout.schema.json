{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage.local/contracts/repository-checkout/1.0.0",
  "title": "RepositoryCheckout",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "origin",
    "repository",
    "revision",
    "checkoutRoot",
    "environment",
    "platform",
    "system",
    "analyzerPack",
    "ruleset"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "origin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?![^/?#]*@)(?!.*(?:\\.git/?|/)$)[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[1-9][0-9]{0,4})?/[A-Za-z0-9._~!$&'()*+,;=:@/-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "checkoutRoot": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "environment": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "platform": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "system": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "analyzerPack": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"},
    "ruleset": {"type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$"}
  }
}
