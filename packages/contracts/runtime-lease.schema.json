{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage.local/contracts/runtime-lease/1.0.0",
  "title": "RuntimeLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "leaseId", "profileId", "profileVersion", "profileDigest",
    "workloadId", "workloadIdentity", "repo", "environment", "artifactDigest", "mechanism",
    "datasets", "permittedGranularity", "windowId", "policyEpoch", "issuedAt", "expiresAt",
    "state", "token"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "leaseId": {"type": "string", "minLength": 1},
    "profileId": {"type": "string", "minLength": 1},
    "profileVersion": {"type": "string", "minLength": 1},
    "profileDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workloadId": {"type": "string", "minLength": 1},
    "workloadIdentity": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mechanism": {"enum": ["OPENLINEAGE", "SDK", "OTEL", "DASK"]},
    "datasets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "permittedGranularity": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["CONNECTIVITY", "DATASET", "ELEMENT"]}
    },
    "windowId": {"type": "string", "minLength": 1},
    "policyEpoch": {"type": "integer", "minimum": 1},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "state": {"enum": ["ACTIVE", "REVOKED", "EXPIRED", "DISABLED"]},
    "token": {"type": "string", "minLength": 1}
  }
}
