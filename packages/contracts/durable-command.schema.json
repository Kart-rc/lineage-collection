{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage.local/contracts/durable-command/1.0.0",
  "title": "DurableCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "idempotencyKey",
    "workflowKind",
    "workflowVersion",
    "scope",
    "artifactDigest",
    "determinantDigest",
    "status",
    "attempt",
    "maxAttempts",
    "inputRef",
    "correlationId",
    "createdAt",
    "deadlineAt"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "commandId": {"type": "string", "minLength": 1},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "workflowKind": {
      "enum": ["BASELINE", "INCREMENTAL", "PR_GATE", "DEPLOYMENT", "NIGHTLY"]
    },
    "workflowVersion": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "artifactDigest": {"type": "string", "minLength": 1},
    "determinantDigest": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "RETRY_WAIT",
        "COMPLETED",
        "FAILED_REDRIVABLE",
        "FAILED_TERMINAL",
        "SUPERSEDED",
        "QUARANTINED"
      ]
    },
    "attempt": {"type": "integer", "minimum": 0},
    "maxAttempts": {"type": "integer", "minimum": 1},
    "inputRef": {"type": "string", "minLength": 1},
    "outputRef": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "causationId": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "deadlineAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETED"}}},
      "then": {"required": ["outputRef"]}
    }
  ]
}
