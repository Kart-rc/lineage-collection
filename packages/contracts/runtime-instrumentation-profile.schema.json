{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lineage.local/contracts/runtime-instrumentation-profile/1.0.0",
  "title": "RuntimeInstrumentationProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "profileVersion", "owner", "workloadId", "workloadIdentity", "repo",
    "environment", "environmentClass", "mechanism", "installMode", "framework",
    "allowedDatasets", "allowedAttributes", "artifactIdentityStrategy",
    "permittedGranularity", "parserContracts", "bufferBudget", "overheadBudget",
    "deploymentCriticality", "canaryPercent", "packageDigest"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "profileId": {"type": "string", "minLength": 1},
    "profileVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "string", "minLength": 1},
    "workloadId": {"type": "string", "minLength": 1},
    "workloadIdentity": {"type": "string", "minLength": 1},
    "repo": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "environmentClass": {"enum": ["PRODUCTION", "ATDD", "NON_PRODUCTION"]},
    "mechanism": {"enum": ["OPENLINEAGE", "SDK", "OTEL", "DASK"]},
    "installMode": {"enum": ["EMBEDDED", "SHARED_COLLECTOR", "SIDECAR", "FRAMEWORK_PLUGIN", "EXISTING_COLLECTOR"]},
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "versionRange"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "versionRange": {"type": "string", "minLength": 1}
      }
    },
    "allowedDatasets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowedAttributes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifactIdentityStrategy": {"const": "DIGEST"},
    "permittedGranularity": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["CONNECTIVITY", "DATASET", "ELEMENT"]}
    },
    "parserContracts": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "bufferBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRecords", "maxBytes", "enqueueTimeoutMs", "maxRetries", "drainTimeoutSeconds"],
      "properties": {
        "maxRecords": {"type": "integer", "minimum": 1},
        "maxBytes": {"type": "integer", "minimum": 1},
        "enqueueTimeoutMs": {"type": "integer", "minimum": 0},
        "maxRetries": {"type": "integer", "minimum": 0},
        "drainTimeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "overheadBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxCpuPercent", "maxMemoryBytes", "maxP95EnqueueMillis"],
      "properties": {
        "maxCpuPercent": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "maxMemoryBytes": {"type": "integer", "minimum": 1},
        "maxP95EnqueueMillis": {"type": "number", "minimum": 0}
      }
    },
    "deploymentCriticality": {"enum": ["REQUIRED", "OPTIONAL"]},
    "canaryPercent": {"type": "integer", "minimum": 0, "maximum": 100},
    "packageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
