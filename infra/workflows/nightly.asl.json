{
  "Comment": "Generated NIGHTLY 1.0.0; large payloads remain versioned S3 references",
  "StartAt": "N1",
  "States": {
    "FAILED_REDRIVABLE": {
      "Error": "FAILED_REDRIVABLE",
      "Type": "Fail"
    },
    "FAILED_TERMINAL": {
      "Error": "FAILED_TERMINAL",
      "Type": "Fail"
    },
    "N1": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FAILED_REDRIVABLE",
          "ResultPath": "$.workflowError"
        }
      ],
      "Next": "N1Outcome",
      "Parameters": {
        "FunctionName": "${ControlAliasArn}",
        "Payload": {
          "causationId.$": "$.causationId",
          "commandId.$": "$.commandId",
          "correlationId.$": "$.correlationId",
          "determinantDigest.$": "$.determinantDigest",
          "idempotencyKey.$": "States.Format('{}:N1', $.idempotencyKey)",
          "input.$": "$.input",
          "schemaVersion.$": "$.schemaVersion",
          "stageId": "N1",
          "stageName": "RECONCILE_EVENTS_RECEIPTS_AND_ARCHIVES",
          "workflowKind": "NIGHTLY",
          "workflowVersion": "1.0.0"
        }
      },
      "Resource": "arn:aws:states:::lambda:invoke",
      "ResultPath": "$._N1",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ECS.AmazonECSException",
            "States.Timeout"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3
        }
      ],
      "TimeoutSeconds": 1800,
      "Type": "Task"
    },
    "N1Outcome": {
      "Choices": [
        {
          "Next": "FAILED_REDRIVABLE",
          "StringEquals": "REDRIVE_REQUIRED",
          "Variable": "$._N1.Payload.outcome"
        }
      ],
      "Default": "N2",
      "Type": "Choice"
    },
    "N2": {
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FAILED_REDRIVABLE",
          "ResultPath": "$.workflowError"
        }
      ],
      "HeartbeatSeconds": 300,
