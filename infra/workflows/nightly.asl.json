        "Cluster": "${ScaClusterArn}",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              "${RuntimeSecurityGroupId}"
            ],
            "Subnets": [
              "${Subnet0}",
              "${Subnet1}",
              "${Subnet2}"
            ]
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Environment": [
                {
                  "Name": "LINEAGE_TASK_TOKEN",
                  "Value.$": "$$.Task.Token"
                },
                {
                  "Name": "LINEAGE_STAGE_SCHEMA_VERSION",
                  "Value.$": "$.schemaVersion"
                },
                {
                  "Name": "LINEAGE_STAGE_COMMAND_ID",
                  "Value.$": "$.commandId"
                },
                {
                  "Name": "LINEAGE_STAGE_CORRELATION_ID",
                  "Value.$": "$.correlationId"
                },
                {
                  "Name": "LINEAGE_STAGE_CAUSATION_ID",
                  "Value.$": "$.causationId"
                },
                {
                  "Name": "LINEAGE_STAGE_DETERMINANT_DIGEST",
                  "Value.$": "$.determinantDigest"
                },
                {
                  "Name": "LINEAGE_STAGE_INPUT",
                  "Value.$": "States.JsonToString($._N1.Payload.output)"
                },
                {
                  "Name": "LINEAGE_STAGE_IDEMPOTENCY_KEY",
                  "Value.$": "States.Format('{}:N2', $.idempotencyKey)"
                },
                {
                  "Name": "LINEAGE_STAGE_ID",
                  "Value": "N2"
                },
                {
                  "Name": "LINEAGE_STAGE_NAME",
                  "Value": "SAMPLE_PUBLISHED_LINEAGE_AGAINST_CLEAN_ANALYSIS"
                },
                {
                  "Name": "LINEAGE_WORKFLOW_KIND",
                  "Value": "NIGHTLY"
                },
                {
                  "Name": "LINEAGE_WORKFLOW_VERSION",
                  "Value": "1.0.0"
                }
              ],
              "Name": "lineage-sca"
            }
          ]
        },
        "TaskDefinition": "${ScaTaskDefinitionArn}"
      },
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "ResultPath": "$._N2",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException",
            "ECS.AmazonECSException",
            "States.Timeout"
